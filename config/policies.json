{
  "policies": [
    {
      "handler": {
        "export": "RateLimitInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "rateLimitBy": "ip",
          "requestsAllowed": 3,
          "timeWindowMinutes": 1,
          "mode": "async"
        }
      },
      "name": "rate-limit-inbound",
      "policyType": "rate-limit-inbound"
    },
    {
      "handler": {
        "export": "SetHeadersOutboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "headers": [
            {
              "name": "X-Emmanuel",
              "value": "test"
            }
          ]
        }
      },
      "name": "set-headers-outbound",
      "policyType": "set-headers-outbound"
    }
  ]
}